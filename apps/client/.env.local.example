# Hasura Configuration
# Replace these URLs with your actual Hasura project URLs
NEXT_PUBLIC_HASURA_GRAPHQL_URL=https://your-hasura-project.hasura.app/v1/graphql
NEXT_PUBLIC_HASURA_WS_URL=wss://your-hasura-project.hasura.app/v1/graphql
NEXT_PUBLIC_HASURA_ADMIN_SECRET=your-admin-secret

# For development, you can also run Hasura locally:
# NEXT_PUBLIC_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
# NEXT_PUBLIC_HASURA_WS_URL=ws://localhost:8080/v1/graphql